@page "/Nasa"
@inject HttpClient Http

<h3>NASA: Astronomy Picture of the Day</h3>

<input type="date" @bind="selectedDate" />
<button @onclick="LoadApodByDate">Bild laden</button>

@if (apodData == null)
{
    <p>Lade Bild des Tages...</p>
}
else
{
    <div>
        <h4>@apodData.title (@apodData.date)</h4>
        <img src="@apodData.url" alt="NASA Bild des Tages" style="max-width: 100%; border-radius: 10px;" />
        <p style="margin-top: 1rem;">@apodData.explanation</p>
    </div>
}

@code {
    private ApodData? apodData;
    private DateTime selectedDate = DateTime.UtcNow;

    protected override async Task OnInitializedAsync()
    {
        await LoadApodByDate(); // Start mit aktuellem Datum
    }

    private async Task LoadApodByDate()
    {
        try
        {
            string formattedDate = selectedDate.ToString("yyyy-MM-dd");
            var response = await Http.GetFromJsonAsync<ApodData>($"api/nasa/apod?date={formattedDate}");
            apodData = response;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Fehler beim Laden der APOD-Daten: {ex.Message}");
        }
    }

    public class ApodData
    {
        public string title { get; set; } = "";
        public string explanation { get; set; } = "";
        public string url { get; set; } = "";
        public string date { get; set; } = "";
    }
}
