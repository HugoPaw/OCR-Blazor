@page "/GeneLab"
@using System.Text.Json
@using System.Net
@inject HttpClient Http

<h2>🧬 Space Bio Dashboard</h2>

@if (studies == null)
{
    <p>Lade Daten...</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Titel</th>
                <th>Organismus</th>
                <th>Plattform</th>
                <th>Link</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in studies)
            {
                <tr>
                    <td>@s.Id</td>
                    <td>@s.Title</td>
                    <td>@s.Organism</td>
                    <td>@s.Platform</td>
                    <td><a href="@s.StudyLink" target="_blank">Zur Studie</a></td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<GeneLabStudy>? studies;

    protected override async Task OnInitializedAsync()
    {
        studies = new List<GeneLabStudy>();
        var ids = new[] { "13", "48", "65", "123", "140" };

        foreach (var id in ids)
        {
            string baseUrl = $"https://genelab-data.ndc.nasa.gov/genelab/data/GLDS/GLDS-{id}/metadata.json";

            try
            {
                // HEAD-Request um Verfügbarkeit zu prüfen
                var headRequest = new HttpRequestMessage(HttpMethod.Head, baseUrl);
                var headResponse = await Http.SendAsync(headRequest);

                if (headResponse.StatusCode == HttpStatusCode.OK)
                {
                    var json = await Http.GetStringAsync(baseUrl);
                    var doc = JsonDocument.Parse(json);
                    var root = doc.RootElement;

                    studies.Add(new GeneLabStudy
                    {
                        Id = $"GLDS-{id}",
                        Title = root.GetProperty("dataset_title").GetString() ?? "-",
                        Organism = root.GetProperty("organism").GetString() ?? "-",
                        Platform = root.GetProperty("platform").GetString() ?? "-",
                        StudyLink = $"https://genelab-data.ndc.nasa.gov/genelab/accession/GLDS-{id}"
                    });
                }
                else
                {
                    studies.Add(new GeneLabStudy
                    {
                        Id = $"GLDS-{id}",
                        Title = $"Nicht verfügbar (HTTP {(int)headResponse.StatusCode})",
                        Organism = "-",
                        Platform = "-",
                        StudyLink = "#"
                    });
                }
            }
            catch (Exception ex)
            {
                studies.Add(new GeneLabStudy
                {
                    Id = $"GLDS-{id}",
                    Title = $"Fehler: {ex.Message}",
                    Organism = "-",
                    Platform = "-",
                    StudyLink = "#"
                });
            }
        }
    }

    public class GeneLabStudy
    {
        public string Id { get; set; } = "";
        public string Title { get; set; } = "";
        public string Organism { get; set; } = "";
        public string Platform { get; set; } = "";
        public string StudyLink { get; set; } = "";
    }
}
