@page "/tictactoe"
<PageTitle>Tic Tac Toe</PageTitle>

<div class="container">
    <h1>Tic Tac Toe vs KI</h1>

    <div class="game-status">
        <h2>@gameMessage</h2>
    </div>

    <div class="game-board">
        @for (int i = 0; i < 9; i++)
        {
            <button class="cell @(GetCellClass(i))"
                    @onclick="@(() => OnCellClicked(i))"
                    disabled="@(!string.IsNullOrEmpty(board[i]) || gameOver)">
                @board[i]
            </button>
        }
    </div>

    @if (gameOver)
    {
        <button class="reset-btn" @onclick="ResetGame">Neues Spiel</button>
    }
</div>

<style>
    .container {
        max-width: 400px;
        margin: auto;
        padding: 20px;
        text-align: center;
        font-family: Arial, sans-serif;
    }

    .game-status {
        margin: 20px 0;
        min-height: 60px;
    }

    .game-board {
        display: grid;
        grid-template-columns: repeat(3, 100px);
        gap: 5px;
        justify-content: center;
    }

    .cell {
        width: 100px;
        height: 100px;
        background-color: #f0f0f0;
        border: 2px solid #333;
        font-size: 36px;
        font-weight: bold;
        cursor: pointer;
    }

        .cell:hover:not(:disabled) {
            background-color: #e0e0e0;
        }

        .cell:disabled {
            cursor: not-allowed;
            opacity: 0.6;
        }

    .player-x {
        color: #e74c3c;
    }

    .player-o {
        color: #3498db;
    }

    .reset-btn {
        margin-top: 20px;
        padding: 10px 20px;
        background-color: #27ae60;
        color: white;
        border: none;
        border-radius: 5px;
        font-size: 16px;
    }

        .reset-btn:hover {
            background-color: #219a52;
        }
</style>

@code {
    private string[] board = new string[9];
    private bool isPlayerTurn = true;
    private bool gameOver = false;
    private string gameMessage = "";

    private static readonly int[,] winCombos = new int[,] {
        {0,1,2}, {3,4,5}, {6,7,8}, // Reihen
        {0,3,6}, {1,4,7}, {2,5,8}, // Spalten
        {0,4,8}, {2,4,6}           // Diagonalen
    };

    protected override void OnInitialized() => ResetGame();

    private async Task OnCellClicked(int index)
    {
        if (!isPlayerTurn || gameOver || !string.IsNullOrEmpty(board[index])) return;

        board[index] = "X";
        isPlayerTurn = false;

        if (CheckWin("X")) { gameMessage = "Du hast gewonnen!"; gameOver = true; return; }
        if (IsDraw()) { gameMessage = "Unentschieden!"; gameOver = true; return; }

        gameMessage = "KI denkt nach...";
        StateHasChanged();
        await Task.Delay(500);

        AIMove();

        if (CheckWin("O")) { gameMessage = "KI hat gewonnen!"; gameOver = true; return; }
        if (IsDraw()) { gameMessage = "Unentschieden!"; gameOver = true; return; }

        gameMessage = "Du bist dran!";
        isPlayerTurn = true;
    }

    private void AIMove()
    {
        var freeCells = Enumerable.Range(0, 9).Where(i => string.IsNullOrEmpty(board[i])).ToList();
        if (freeCells.Any())
        {
            var rnd = new Random();
            int move = freeCells[rnd.Next(freeCells.Count)];
            board[move] = "O";
        }
    }

    private bool CheckWin(string symbol)
    {
        for (int i = 0; i < winCombos.GetLength(0); i++)
        {
            if (symbol == board[winCombos[i, 0]] &&
                symbol == board[winCombos[i, 1]] &&
                symbol == board[winCombos[i, 2]])
            {
                return true;
            }
        }
        return false;
    }

    private bool IsDraw() => board.All(cell => !string.IsNullOrEmpty(cell));

    private string GetCellClass(int index) =>
        board[index] == "X" ? "player-x" :
        board[index] == "O" ? "player-o" : "";

    private void ResetGame()
    {
        board = new string[9];
        isPlayerTurn = true;
        gameOver = false;
        gameMessage = "Du bist dran!";
    }
}
