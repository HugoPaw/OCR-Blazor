@page "/ball"
@inject IJSRuntime JS

<h3 class="mb-4 text-xl">3D-Ball Steuerung</h3>

<div id="ball3d" style="width: 400px; height: 400px;"></div>

<div class="mt-4 flex gap-2">
    <button @onclick="@(() => Rotate("up"))">⬆️</button>
    <button @onclick="@(() => Rotate("left"))">⬅️</button>
    <button @onclick="@(() => Rotate("right"))">➡️</button>
    <button @onclick="@(() => Rotate("down"))">⬇️</button>
</div>

<script>
    // Lade THREE.js dynamisch, wenn noch nicht vorhanden
    if (!window.THREE) {
        const script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/three@0.149.0/build/three.min.js';
        script.onload = () => {
            initBall();
        };
        document.head.appendChild(script);
    } else {
        initBall();
    }

    let scene, camera, renderer, sphere;
    const step = Math.PI / 16;

    function initBall() {
        const container = document.getElementById('ball3d');
        if (!container || !window.THREE) return;

        container.innerHTML = '';

        scene = new THREE.Scene();
        camera = new THREE.PerspectiveCamera(75, container.clientWidth / container.clientHeight, 0.1, 1000);
        camera.position.z = 3;

        renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.setSize(container.clientWidth, container.clientHeight);
        container.appendChild(renderer.domElement);

        const geometry = new THREE.SphereGeometry(1, 64, 64);
        const colors = ['red', 'green', 'blue', 'yellow', 'cyan', 'magenta', 'orange', 'purple'];
        const materials = colors.map(c => new THREE.MeshBasicMaterial({ color: c }));

        geometry.clearGroups();
        const segmentCount = 8;
        const indexCount = geometry.index.count;
        const facesPerSegment = indexCount / segmentCount;

        for (let i = 0; i < segmentCount; i++) {
            geometry.addGroup(i * facesPerSegment, facesPerSegment, i);
        }

        sphere = new THREE.Mesh(geometry, materials);
        scene.add(sphere);

        animate();
    }

    function animate() {
        requestAnimationFrame(animate);
        renderer.render(scene, camera);
    }

    window.rotateBall = (dir) => {
        if (!sphere) return;
        switch (dir) {
            case 'left': sphere.rotation.y -= step; break;
            case 'right': sphere.rotation.y += step; break;
            case 'up': sphere.rotation.x -= step; break;
            case 'down': sphere.rotation.x += step; break;
        }
    };
</script>

@code {
    void Rotate(string direction)
    {
        _ = JS.InvokeVoidAsync("rotateBall", direction);
    }
}
